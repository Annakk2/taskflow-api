# PostgreSQL connection used when running the app locally (outside Docker).
# When running via `docker compose up`, this value is overridden by docker-compose.yml
# (which points at the `db` service instead of localhost) — no edits needed for Docker.
DATABASE_URL=postgresql+psycopg2://taskflow:taskflow@localhost:5432/taskflow

# Application
LOG_LEVEL=INFO
ENVIRONMENT=development
